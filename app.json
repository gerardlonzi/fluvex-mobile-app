{
  "expo": {
    "name": "Fluvex Driver",
    "slug": "fluvex-driver",
    "scheme": "fluvexdriver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mini-logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/mini-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tonnom.fluvexdriver"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/mini-logo.png",
        "backgroundColor": "#020617"
      },
      "package": "com.tonnom.fluvexdriver"
    },
    "web": {
      "favicon": "./assets/images/mini-logo.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Autorisez la localisation pour suivre les livraisons en temps réel."
        }
      ]
    ]
  }
}